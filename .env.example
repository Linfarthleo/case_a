# Copy to .env for local runs. NEVER commit real secrets: use env vars / Secret Manager.
APP_ENV=dev

AUTH_MODE=mock

# mock | openai (any OpenAI-compatible Chat Completions endpoint)
LLM_PROVIDER=mock
LLM_MODEL=mock-model-v1
LLM_FALLBACK_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=  <- inject from Secret Manager, never commit
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS_PER_CALL=600
LLM_INPUT_COST_PER_1K_TOKENS=0.00015
LLM_OUTPUT_COST_PER_1K_TOKENS=0.0006

MCP_TIMEOUT_MS=3000
MCP_MAX_RETRIES=2
MCP_TOP_K=3
PERMISSIONS_TIMEOUT_MS=2000

RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=2000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_S=30

MAX_LLM_CALLS_PER_REQUEST=3
MAX_LLM_RETRIES_PER_REQUEST=1
MAX_TOOL_CALLS_PER_REQUEST=3
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=1200
MAX_ESTIMATED_COST_USD=0.10
REQUEST_DEADLINE_MS=20000

GUARDRAIL_MODE=rules
INJECTION_THRESHOLD=0.5
MAX_QUERY_CHARS=2000
MAX_ANSWER_CHARS=4000
OUTPUT_REQUIRE_CITATIONS=true

PROMPT_VERSION=system_v1

LOG_LEVEL=INFO
LOG_PROMPT_CONTENT=false
LOG_DOCUMENT_CONTENT=false

OTEL_ENABLED=true
# none | console
OTEL_EXPORTER=none
METRICS_ENDPOINT_ENABLED=true
